# Copy this file to .env.local and fill in the values from your Neon project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_URL=http://localhost:3000
# Use a private random secret of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-private-random-secret

# Napoleon runs as a separate service. Include its /api/v1 prefix.
NAPOLEON_API_URL=http://localhost:3010/api/v1
# Use a Napoleon READ key for chat. Keep it server-side; do not expose it to the browser.
NAPOLEON_API_KEY=replace-with-your-napoleon-read-api-key

# Optional: commercial map tiles (MapTiler / Stadia). Leave unset to use OpenStreetMap while testing.
# NEXT_PUBLIC_MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
