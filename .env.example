# Copy this file to .env.local and set DATABASE_URL from Neon -> Project -> Connect.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# The exact address you open in the browser (localhost, 127.0.0.1 or your LAN HTTPS address).
# This must match the origin you browse, otherwise sign-in succeeds but every page shows "Unauthorized".
BETTER_AUTH_URL=http://localhost:3000
# Optional: other origins allowed to sign in, comma separated (e.g. the phone's HTTPS LAN address).
# BETTER_AUTH_TRUSTED_ORIGINS=https://192.168.1.156:3000
# Generate a private random secret locally; keep it out of Git and chat.
BETTER_AUTH_SECRET=replace-with-a-private-random-secret-of-at-least-32-characters

# Napoleon runs as a separate service. Include its /api/v1 prefix.
NAPOLEON_API_URL=http://localhost:3010/api/v1
# Use a Napoleon READ key for chat. Keep it server-side; do not expose it to the browser.
NAPOLEON_API_KEY=replace-with-your-napoleon-read-api-key

# Optional: commercial map tiles (MapTiler / Stadia). Leave unset to use OpenStreetMap while testing.
# NEXT_PUBLIC_MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY

# Optional: text shown under the company name in the sidebar.
# NEXT_PUBLIC_BRAND_TAGLINE=Fortewings Security
